<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aetherdecompiler</groupId>
        <artifactId>aether-decompiler</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>aether-gui</artifactId>

    <name>aether-gui</name>
    <description>
        JavaFX desktop application on top of the kernel. Like the CLI, it is only
        a caller of the engine and never part of it. Provides a themable
        three-view decompiler studio with a pluggable skin system.
    </description>

    <properties>
        <javafx.version>21.0.5</javafx.version>
        <richtextfx.version>0.11.2</richtextfx.version>
        <mainClass>com.aetherdecompiler.gui.AetherLauncher</mainClass>
    </properties>

    <dependencies>
        <!-- 内核 + 官方插件：GUI 是纯调用方。 -->
        <dependency>
            <groupId>com.aetherdecompiler</groupId>
            <artifactId>aether-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aetherdecompiler</groupId>
            <artifactId>plugin-source-jar</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aetherdecompiler</groupId>
            <artifactId>plugin-render-dot</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JavaFX（仅桌面）。 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- 视频背景 / Wallpaper Engine 视频壁纸。 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- RichTextFX：工作台的代码编辑器。 -->
        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>${richtextfx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
